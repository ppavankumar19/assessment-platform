# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Judge0 Code Execution ───────────────────────────────────────────────────
# Option 1: Self-hosted Judge0
# JUDGE0_API_URL=https://your-judge0-instance.fly.dev
# JUDGE0_API_KEY=your-judge0-auth-token

# Option 2: RapidAPI Judge0 CE (no Docker needed)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-char-random-string

# ── Admin Bootstrap ──────────────────────────────────────────────────────────
ADMIN_BOOTSTRAP_TOKEN=replace-with-random-token
