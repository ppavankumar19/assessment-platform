PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Personal Access Token — only needed to run migrations (scripts/migrate.mjs)
# Generate one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Comma-separated list of allowed CORS origins (no trailing slash)
FRONTEND_URL=http://localhost:4000

# Set to "true" to enable maintenance mode (all API requests return 503)
MAINTENANCE_MODE=false
LOG_LEVEL=warn
